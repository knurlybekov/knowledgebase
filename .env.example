# Copy to .env and fill in. Never commit .env.
# --- Django ---
SECRET_KEY=change-me-50-random-characters
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000

# --- Database (local compose publishes Postgres on 127.0.0.1:5435) ---
# Runtime processes connect as kb_app; `make migrate` and `make test` use kb_migrator.
DATABASE_URL=postgres://kb_app:kb_app@127.0.0.1:5435/kb
MIGRATOR_DATABASE_URL=postgres://kb_migrator:kb_migrator@127.0.0.1:5435/kb

# --- Celery / cache (local compose publishes Redis on 127.0.0.1:6381) ---
CELERY_BROKER_URL=redis://127.0.0.1:6381/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6381/1
CELERY_TASK_ALWAYS_EAGER=False

# --- Embeddings: mock | openai ---
EMBEDDER=mock
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_MODEL_VERSION=2024-01
EMBEDDING_DIM=1536
OPENAI_API_KEY=

# --- Answer LLM: stub | anthropic | openai ---
LLM_PROVIDER=stub
LLM_MODEL=
ANTHROPIC_API_KEY=

# --- Connector credentials. Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CONNECTOR_TOKEN_KEY=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=organizations
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Permission freshness (seconds). Reconcile must be <= half of the freshness bound.
PERMISSION_FRESHNESS_MAX_AGE_S=86400
FULL_RECONCILE_INTERVAL_S=43200
PURGE_GRACE_S=172800
SYNC_INTERVAL_S=900

# --- Hermes investigations ---
HERMES_ENABLED=False
RUNNER_URL=http://hermes-agent:8700
RUNNER_SHARED_SECRET=change-me
INVESTIGATION_MAX_TURNS=12
INVESTIGATION_MAX_TOOL_CALLS=20
INVESTIGATION_TIMEOUT_S=180
INVESTIGATION_MAX_OUTPUT_CHARS=60000

# --- Hermes container (read by hermes/runner inside the hermes-agent service) ---
HERMES_MODEL=anthropic/claude-sonnet-4-6
HERMES_PROVIDER_API_KEY_ENV=ANTHROPIC_API_KEY

# --- Metrics (internal network only) ---
METRICS_TOKEN=
